    dual_headed: 0;
    cost_factor: 16;
    running_cost_factor: 46;
    speed: 160 km/h;
    cargo_capacity: 1;
    track_type:TR_1435_DC;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
