// purchase
  spriteset(e464_purchase_body, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(e464_purchase_body_2cc, "src/loco/e464/e464_2cc.png"){ tmpl_purchase_1c_2cc(0, 0) }
  spriteset(e464_purchase_panto, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_panto.png"){ tmpl_purchase_1c(0, 0) }
  TRAIN_CONSTRUCTOR_2(e464_purchase,  e464_purchase_body,  e464_purchase_panto)
  TRAIN_CONSTRUCTOR_3(e464_purchase_2cc,  e464_purchase_body, e464_purchase_body_2cc,  e464_purchase_panto)
//base
  spriteset(e464_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(e464_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_e464_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: e464_lights_end;
    e464_lights_front;
  }
  spriteset(sw_e464_panto, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_panto.png"){ tmpl_std_v3(0, 0) }

spriteset(gfx_e464_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/loco/e464/e464_1.png"){ tmpl_std_v3(0, 0) }
spriteset(gfx_e464_2cc, "src/loco/e464/e464_2cc.png"){ tmpl_std_v3(0, 0) }

  TRAIN_CONSTRUCTOR_3(sw_e464,  gfx_e464_1,  sw_e464_panto, sw_e464_lights)
  TRAIN_CONSTRUCTOR_4(sw_e464_2cc,  gfx_e464_1, gfx_e464_2cc, sw_e464_panto, sw_e464_lights)

