 TR_1435_ACDC: [SAAE, ELRL],
 TR_1435_METRO: [SAA3, SAB3, "3RDR", MTRO, ELRL],
 TR_1435_LINEAR: [SAAI, SAAD, ELRL],
  TR_3000_GUIDE: [rAA3, rAAE, ELRL],
 TR_UNIVERSAL: [_AAE, RAIL],
}
